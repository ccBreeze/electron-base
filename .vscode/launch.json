{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Main Process",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--sourcemap"],
      "autoAttachChildProcesses": true,
      "outFiles": ["${workspaceFolder}/out/main/**/*.js"],
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "附加主进程（9229）",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "timeout": 60000,
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/out/main/**/*.js"],
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"],
      "continueOnAttach": false,
      "restart": true
    }
  ]
}
