{
  "name": "electron-base",
  "version": "1.0.0",
  "rendererVersion": "1.0.0.1",
  "type": "module",
  "description": "An Electron application with Vue and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev -w -c build/config/electron.vite.ts",
    "dev:debug": "npm run dev -- --inspect=9229 --sourcemap",
    "dev:debug-brk": "npm run dev -- --inspectBrk=9229 --sourcemap",
    "build": "npm run typecheck && electron-vite build -c build/config/electron.vite.ts",
    "build:renderer": "npm run typecheck:web && electron-vite build -c build/config/renderer.ts",
    "build:renderer-pro": "npm run build:renderer -- -- --compress",
    "build:renderer-uat": "npm run build:renderer -- --mode uat -- --compress",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder -c electron-builder.config.js --win",
    "build:win-uat": "npm run build -- --mode uat && electron-builder -c electron-builder.config.js --win",
    "build:mac": "npm run build && electron-builder -c electron-builder.config.js --mac",
    "build:mac-uat": "npm run build -- --mode uat && electron-builder -c electron-builder.config.js --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "postinstall": "install-electron --no && electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "vue-router": "^4.4.5",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@9.9.0+sha512.60c18acd138bff695d339be6ad13f7e936eea6745660d4cc4a776d5247c540d0edee1a563695c183a66eb917ef88f2b4feb1fc25f32a7adcadc7aaf3438e99c1"
}
